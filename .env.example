# Explicitly synthetic first implementation. Real input/pilot is disabled.
TSR_MODE=demo
TSR_ALLOW_SYNTHETIC_DRAFT=true
TSR_DATABASE_URL=postgresql://tsr:tsr-local-demo@db:5432/tsr
TSR_ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
TSR_IDENTITY_HMAC_KEY_FILE=/run/secrets/identity_hmac_key
TSR_MAX_BOT_TOKEN_FILE=/run/secrets/max_bot_token
TSR_WEBHOOK_SECRET_FILE=/run/secrets/webhook_secret
TSR_HEALTH_TOKEN_FILE=/run/secrets/health_token
TSR_MAX_API_URL=https://platform-api2.max.ru
TSR_PRIVATE_ROOT=/var/lib/tsr/blobs
TSR_RELEASE_ROOT=/app
TSR_RELEASE_COMMIT=first-mvp-development
TSR_BOT_SCOPE=tsr-demo
TSR_RENDER_TIMEOUT_SECONDS=45
# Optional verified CA bundle: see docs/integrations/MAX.md and compose.max-ca.yaml.
# TSR_MAX_CA_BUNDLE=/run/max-ca/ca-bundle.pem
# Real bot setup also needs TSR_WEBHOOK_URL=https://your-host.example/webhooks/max
